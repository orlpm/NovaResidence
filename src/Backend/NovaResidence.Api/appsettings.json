{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=NovaResidenceDb;Trusted_Connection=true;MultipleActiveResultSets=true"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "http://localhost:3002",
      "http://localhost:5173",
      "http://localhost:19006"
    ]
  },
  "Azure": {
    "StorageAccountName": "novaresidencestorage",
    "ServiceBusNamespace": "novaresidence-servicebus",
    "KeyVaultUri": "https://novaresidence-kv.vault.azure.net/",
    "ApplicationInsightsConnectionString": ""
  },
  "Jwt": {
    "Issuer": "NovaResidence",
    "Audience": "NovaResidenceApp",
    "SecretKey": "NovaResidence-Super-Secret-Key-2024-Min32Chars!@#",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  }
}
